---
import '../styles/global.css';
import site from '../data/site.json';
const { title = `${site.shortNames} | Wedding Celebration`, description = 'Join us as we celebrate a beautiful new beginning.' } = Astro.props;
const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const navItems = [
  { href: '/', label: 'Invitation' },
  { href: '/events/', label: 'Events' },
  { href: '/updates/', label: 'Updates' },
  { href: '/gallery/', label: 'Gallery' },
];
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#6f2033" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  </head>
  <body>
    <header class="site-header sticky top-0 z-40">
      <div class="page-shell flex min-h-16 flex-col items-center gap-2 py-3 sm:flex-row sm:justify-between sm:gap-4">
        <a href={base} class="serif text-center text-xl leading-tight text-[var(--maroon)] no-underline sm:text-left" aria-label="Wedding home" data-reveal style="--reveal-delay: 40ms">{site.shortNames}</a>
        <nav class="grid w-full grid-cols-4 items-center justify-items-center gap-x-1 sm:flex sm:w-auto sm:justify-end sm:gap-x-6" aria-label="Main navigation" data-reveal style="--reveal-delay: 120ms">
          {navItems.map((item) => {
            const href = item.href === '/' ? base : `${base}${item.href.replace(/^\//, '')}`;
            const isCurrent = item.href === '/' ? currentPath === '/' : currentPath.startsWith(item.href);
            return <a class="nav-link whitespace-nowrap text-center" href={href} aria-current={isCurrent ? 'page' : undefined}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="mt-20">
      <div class="page-shell py-10 text-center">
        <p class="eyebrow text-[var(--gold-light)]">With love and blessings</p>
        <p class="serif mt-2 text-3xl">{site.shortNames}</p>
        <p class="mx-auto mt-3 max-w-md text-sm text-white/70">{site.invitationLine}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm">
          <a href={`${base}events/`}>Celebrations</a><a href={`${base}updates/`}>Latest updates</a><a href={`${base}gallery/`}>Memories</a>
        </div>
      </div>
    </footer>
    <script>
      const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealTargets.forEach((target) => target.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -32px 0px' });

        revealTargets.forEach((target) => revealObserver.observe(target));
      }
    </script>
  </body>
</html>
