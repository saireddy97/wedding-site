---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import gallery from '../data/gallery.json';
import site from '../data/site.json';
---
<BaseLayout title={`Gallery | ${site.shortNames}`} description="A collection of moments and details from our wedding celebration.">
  <section class="page-shell py-14 sm:py-20">
    <header class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-[var(--gold)]">Little moments, forever memories</p>
      <h1 class="serif mt-3 text-5xl text-[var(--maroon)] sm:text-6xl">The gallery</h1>
    </header>
    <div class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-5">
      {gallery.map((photo, index) => <figure class={`gallery-item ${index === 0 || index === 5 ? 'row-span-2 min-h-72 sm:min-h-[440px]' : 'min-h-48 sm:min-h-64'}`}>
        <img class="gallery-image" src={photo.src} alt={photo.alt} loading="lazy" />
        <figcaption class="sr-only">{photo.caption}</figcaption>
      </figure>)}
    </div>
    <div class="mt-10 text-center"><ShareButton message={`Visit the wedding gallery for ${site.shortNames}:`} label="Share the gallery" /></div>
  </section>
</BaseLayout>
