---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import events from '../data/events.json';
import site from '../data/site.json';
---
<BaseLayout title={`Celebrations | ${site.shortNames}`} description="Dates, times and details for each wedding celebration.">
  <section class="page-shell py-14 sm:py-20">
    <header class="mx-auto max-w-2xl text-center">
      <p class="eyebrow text-[var(--gold)]">Mark your calendars</p>
      <h1 class="serif mt-3 text-5xl text-[var(--maroon)] sm:text-6xl">The celebrations</h1>
      <p class="mt-5 text-[var(--muted)]">We look forward to celebrating each tradition with you. Details will be updated as they are confirmed.</p>
    </header>
    <div class="mx-auto mt-12 max-w-3xl space-y-5">
      {events.map((event, index) => <article class="card event-card grid gap-4 p-5 sm:grid-cols-[88px_1fr] sm:gap-6 sm:p-7">
        <div class="flex h-20 w-20 flex-col items-center justify-center border border-[var(--gold-light)] text-center">
          <span class="serif text-3xl text-[var(--maroon)]">{String(index + 1).padStart(2, '0')}</span>
          <span class="text-xs text-[var(--gold)]">EVENT</span>
        </div>
        <div>
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div><p class="eyebrow text-[var(--gold)]">{event.date || 'Date to be announced'}</p><h2 class="serif mt-1 text-3xl text-[var(--maroon)]">{event.name}</h2></div>
            <span class="text-2xl text-[var(--gold)]" aria-hidden="true">{event.icon}</span>
          </div>
          <p class="mt-3 text-[var(--muted)]">{event.description}</p>
          <dl class="mt-5 grid gap-3 text-sm sm:grid-cols-2">
            <div><dt class="font-semibold text-[var(--maroon)]">Time</dt><dd>{event.time}</dd></div>
            <div><dt class="font-semibold text-[var(--maroon)]">Venue</dt><dd>{event.venue}</dd></div>
            <div><dt class="font-semibold text-[var(--maroon)]">Dress code</dt><dd>{event.dressCode}</dd></div>
          </dl>
          <a class="mt-5 inline-flex text-sm font-semibold text-[var(--maroon)] underline underline-offset-4" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Open venue map ↗</a>
        </div>
      </article>)}
    </div>
    <div class="mt-10 text-center"><ShareButton message={`See the wedding event schedule for ${site.shortNames}:`} label="Share event schedule" /></div>
  </section>
</BaseLayout>
