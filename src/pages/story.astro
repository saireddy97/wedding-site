---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title={`Our Story | ${site.shortNames}`} description={`The story of ${site.shortNames}, told one moment at a time.`}>
  <section class="hero-pattern border-b border-[var(--line)]">
    <div class="page-shell py-20 text-center sm:py-28">
      <p class="eyebrow text-[var(--gold)]" data-reveal>Our story</p>
      <h1 class="serif mt-4 text-5xl text-[var(--maroon)] sm:text-6xl" data-reveal style="--reveal-delay: 100ms">Moments that brought us here</h1>
      <p class="mx-auto mt-5 max-w-xl text-[var(--muted)]" data-reveal style="--reveal-delay: 180ms">The little moments, memories, and milestones that make our story ours.</p>
    </div>
  </section>
</BaseLayout>
